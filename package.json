{
  "name": "event-driven-ecommerce",
  "version": "0.1.0",
  "private": true,
  "description": "Event-driven e-commerce backend: Kafka, transactional outbox, saga with compensation, CQRS (TypeScript/NestJS)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MITRAKER/event-driven-ecommerce.git"
  },
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:tools": "node --test tools/eslint-rules/no-recursion.test.mjs",
    "test:e2e": "node tests/e2e/e2e.mjs",
    "check": "npm run format:check && npm run build && npm run lint && npm run typecheck && npm run test:cov && npm run test:tools",
    "prepare": "husky || true",
    "start:order": "npm start -w @shop/order-service",
    "start:inventory": "npm start -w @shop/inventory-service",
    "start:payment": "npm start -w @shop/payment-service",
    "start:query": "npm start -w @shop/order-query-service"
  },
  "lint-staged": {
    "*.{ts,mjs,js}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-jest": "^29.17.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
